# ========== Python 环境与缓存 ==========
# uv 创建的虚拟环境（本地生成，不入库）
.venv/
# Python 字节码缓存目录
__pycache__/
# 编译后的字节码文件
*.pyc

# ========== 敏感配置 ==========
# 真实环境变量（含密钥），只提交模板 .env.example
.env

# ========== 编辑器 / IDE ==========
# PyCharm / IntelliJ 配置
.idea/
# VS Code 配置
.vscode/

# ========== 本地数据与运行产物 ==========
# 输入文档池（本地素材，clone 后自建）
doc/
# 处理产物（chunks 备份、转换后的 markdown 等）
output/
# 运行日志
logs/